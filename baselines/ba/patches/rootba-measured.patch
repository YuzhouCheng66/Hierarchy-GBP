@@ -232,8 +236,42 @@ class LandmarkBlockSC {
     return storage_.template block<2, POSE_SIZE>(2 * obs_idx, 0);
   }
 
+  inline auto get_ri(const size_t obs_idx) const {
+    return storage_.template block<2, 1>(2 * obs_idx, res_idx_);
+  }
+
+  inline std::pair<Mat3, Vec3> prepare_Hll_inv_bl() const {
+    Mat3 Hll = Mat3::Zero();
+    Vec3 bl = Vec3::Zero();
+    for (size_t i = 0; i < pose_idx_.size(); ++i) {
+      const auto Jl = get_Jli(i);
+      const auto r = get_ri(i);
+      for (int col = 0; col < 3; ++col) {
+        bl[col] += Jl(0, col) * r[0] + Jl(1, col) * r[1];
+        for (int row = 0; row <= col; ++row) {
+          Hll(row, col) +=
+              Jl(0, row) * Jl(0, col) + Jl(1, row) * Jl(1, col);
+        }
+      }
+    }
+    for (int col = 0; col < 3; ++col) {
+      for (int row = col + 1; row < 3; ++row) {
+        Hll(row, col) = Hll(col, row);
+      }
+    }
+    Hll_inv_ = Hll;
+    Hll_inv_.diagonal().array() += lambda_;
+    Hll_inv_ = Hll_inv_.inverse().eval();
+    const Vec3 Hll_inv_bl = Hll_inv_ * bl;
+    return {Hll_inv_, Hll_inv_bl};
+  }
