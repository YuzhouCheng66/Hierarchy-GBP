set(_pure_dir "${CMAKE_CURRENT_LIST_DIR}")
add_library(hgbp_pure_coarse "${_pure_dir}/src/solver.cpp")
target_include_directories(hgbp_pure_coarse PUBLIC "${_pure_dir}/include" PRIVATE "${PROJECT_SOURCE_DIR}/include" "${HGBP_EIGEN_DIR}")
target_link_libraries(hgbp_pure_coarse PUBLIC OpenMP::OpenMP_CXX)
hgbp_compile(hgbp_pure_coarse)
foreach(_space se2 se3)
    target_compile_definitions(hgbp_${_space} PRIVATE HGBP_PURE_GBP)
    target_link_libraries(hgbp_${_space} PRIVATE hgbp_pure_coarse)
endforeach()
if(BUILD_TESTING)
    add_executable(pure_gbp_test "${_pure_dir}/tests/numerics.cpp")
    target_include_directories(pure_gbp_test PRIVATE "${PROJECT_SOURCE_DIR}/include" "${HGBP_EIGEN_DIR}")
    target_link_libraries(pure_gbp_test PRIVATE hgbp_pure_coarse)
    set_target_properties(pure_gbp_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/pgo")
    hgbp_compile(pure_gbp_test)
    add_test(NAME pure_gbp_numerics COMMAND pure_gbp_test)
    set_tests_properties(pure_gbp_numerics PROPERTIES ENVIRONMENT "OPENBLAS_NUM_THREADS=1;MKL_NUM_THREADS=1;OMP_DYNAMIC=FALSE")
endif()
